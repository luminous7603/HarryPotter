---
interface Props {
  title: string;
  type: string;
  teaser: string;
  releaseDate?: string;
  href?: string;
}

const { title, type, teaser, releaseDate, href = '/upcoming' } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl border border-[var(--color-hp-gold)]/30 bg-gradient-to-r from-[var(--color-hp-gold)]/10 to-transparent p-5 card-hover hover:border-[var(--color-hp-gold)]/60"
>
  <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[var(--color-hp-gold)]/20 flex items-center justify-center">
    <span class="text-2xl">✨</span>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-medium text-[var(--color-hp-gold)] uppercase tracking-wider bg-[var(--color-hp-gold)]/10 px-2 py-0.5 rounded">
        {type}
      </span>
      {releaseDate && (
        <span class="text-xs text-[var(--color-hp-parchment)]/40">{releaseDate}</span>
      )}
    </div>
    <h3 class="font-serif text-lg text-[var(--color-hp-parchment)] group-hover:text-[var(--color-hp-gold)] transition-colors">
      {title}
    </h3>
    <p class="text-sm text-[var(--color-hp-parchment)]/50 mt-1 line-clamp-2">{teaser}</p>
  </div>
  <span class="text-[var(--color-hp-gold)]/40 group-hover:text-[var(--color-hp-gold)] transition-colors text-xl flex-shrink-0">→</span>
</a>
